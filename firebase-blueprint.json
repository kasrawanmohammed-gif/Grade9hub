{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Private authenticated student or teacher account profile stored in Firestore so accounts never disappear on app updates or URL changes.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the account owner."
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Full display name of the student or teacher."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 180,
          "description": "Account email address (strictly owner or admin readable)."
        },
        "role": {
          "type": "string",
          "enum": ["student", "teacher"],
          "description": "Account role; teachers/admins cannot be self-assigned by non-admin users."
        },
        "isAdmin": {
          "type": "boolean",
          "description": "Whether this user holds main administrator privileges."
        },
        "grade": {
          "type": "string",
          "maxLength": 40,
          "description": "Optional student grade label."
        },
        "bio": {
          "type": "string",
          "maxLength": 500,
          "description": "Short biography text."
        },
        "birthday": {
          "type": "string",
          "maxLength": 20,
          "description": "Student birthday in YYYY-MM-DD format."
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 200000,
          "description": "Compacted Base64 WebP avatar data URI or empty string."
        },
        "notificationsEnabled": {
          "type": "boolean",
          "description": "Whether push/in-app notifications are enabled."
        },
        "notifPromptStatus": {
          "type": "string",
          "enum": ["", "allowed", "denied"],
          "description": "Saved notification permission choice."
        },
        "totalPoints": {
          "type": "number",
          "description": "Total student competition points."
        },
        "quizzesCompleted": {
          "type": "number",
          "description": "Total completed quizzes count."
        },
        "correctAnswers": {
          "type": "number",
          "description": "Total correct answers count."
        },
        "isRestricted": {
          "type": "boolean",
          "description": "Whether the account is restricted by an administrator."
        },
        "restrictionReason": {
          "type": "string",
          "maxLength": 300,
          "description": "Optional reason for account restriction."
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp string of the latest sign-in."
        },
        "lastActiveAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp string of the latest activity."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of account creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": ["uid", "name", "email", "role", "isAdmin", "createdAt", "updatedAt"]
    },
    "QuizAttemptRecord": {
      "title": "QuizAttemptRecord",
      "description": "Immutable completed quiz record under a student account for cross-update progress preservation.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Parent user UID."
        },
        "mode": {
          "type": "string",
          "enum": ["all_chapters", "chapter", "general"],
          "description": "Quiz mode."
        },
        "chapterNumber": {
          "type": "number",
          "description": "Chapter number 1-11 or 0 for general/all-chapters."
        },
        "totalQuestions": {
          "type": "number",
          "description": "Number of questions in the quiz."
        },
        "correctCount": {
          "type": "number",
          "description": "Number of correct answers."
        },
        "scorePercent": {
          "type": "number",
          "description": "Score percentage 0-100."
        },
        "pointsAwarded": {
          "type": "number",
          "description": "Competition points awarded for this attempt."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when attempt was recorded."
        }
      },
      "required": ["userId", "mode", "chapterNumber", "totalQuestions", "correctCount", "scorePercent", "pointsAwarded", "createdAt"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "PII-free student competition scoreboard entry visible to signed-in users.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Student UID."
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Student display name."
        },
        "grade": {
          "type": "string",
          "maxLength": 40,
          "description": "Student grade."
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 200000,
          "description": "Compacted Base64 avatar or empty string."
        },
        "role": {
          "type": "string",
          "enum": ["student"],
          "description": "Must always be student for leaderboard entries."
        },
        "totalPoints": {
          "type": "number",
          "description": "Total student competition points."
        },
        "quizzesCompleted": {
          "type": "number",
          "description": "Completed quizzes count."
        },
        "correctAnswers": {
          "type": "number",
          "description": "Correct answers count."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest score sync."
        }
      },
      "required": ["uid", "name", "role", "totalPoints", "quizzesCompleted", "correctAnswers", "updatedAt"]
    },
    "AdminRegistryEntry": {
      "title": "AdminRegistryEntry",
      "description": "Verified administrator allowlist document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Admin UID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 180,
          "description": "Verified admin email."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp."
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "SchoolAccountSyncRecord": {
      "title": "SchoolAccountSyncRecord",
      "description": "Admin-only cloud mirror of local student/teacher accounts for surviving app rebuilds and URL changes.",
      "type": "object",
      "properties": {
        "accountKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Deterministic key derived from normalized email."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 180,
          "description": "Normalized account email."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Account display name."
        },
        "role": {
          "type": "string",
          "enum": ["student", "teacher"],
          "description": "Account role."
        },
        "isAdmin": {
          "type": "boolean",
          "description": "Admin privilege flag."
        },
        "passwordHash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Bcrypt password hash."
        },
        "grade": {
          "type": "string",
          "maxLength": 40,
          "description": "Grade label."
        },
        "bio": {
          "type": "string",
          "maxLength": 500,
          "description": "Biography."
        },
        "birthday": {
          "type": "string",
          "maxLength": 20,
          "description": "Birthday string."
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 200000,
          "description": "Compacted Base64 avatar or empty string."
        },
        "notifPromptStatus": {
          "type": "string",
          "enum": ["", "allowed", "denied"],
          "description": "Notification choice."
        },
        "notificationsEnabled": {
          "type": "boolean",
          "description": "Notification enabled state."
        },
        "createdAtIso": {
          "type": "string",
          "maxLength": 64,
          "description": "Original account creation timestamp string."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest sync."
        }
      },
      "required": ["accountKey", "email", "name", "role", "isAdmin", "passwordHash", "updatedAt"]
    },
    "PeerPresence": {
      "title": "PeerPresence",
      "description": "PII-free live online/offline presence and community peer profile document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID."
        },
        "numericId": {
          "type": "number",
          "description": "Deterministic numeric ID mapped for community views."
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Display name."
        },
        "role": {
          "type": "string",
          "enum": ["student", "teacher"],
          "description": "Account role."
        },
        "isAdmin": {
          "type": "boolean",
          "description": "Whether the user has admin privileges."
        },
        "grade": {
          "type": "string",
          "maxLength": 40,
          "description": "Grade label."
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 200000,
          "description": "Compacted avatar URI or empty string."
        },
        "bio": {
          "type": "string",
          "maxLength": 500,
          "description": "Short biography."
        },
        "online": {
          "type": "boolean",
          "description": "Live online status flag."
        },
        "currentSection": {
          "type": "string",
          "maxLength": 40,
          "description": "Current active section name."
        },
        "isRestricted": {
          "type": "boolean",
          "description": "Whether account is restricted."
        },
        "lastActiveAtIso": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO string of last heartbeat."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest heartbeat."
        }
      },
      "required": ["uid", "name", "role", "isAdmin", "online", "updatedAt"]
    },
    "AppSettingsDoc": {
      "title": "AppSettingsDoc",
      "description": "Global application settings controlled by administrators.",
      "type": "object",
      "properties": {
        "settingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Fixed document ID 'global'."
        },
        "scope": {
          "type": "string",
          "enum": ["public"],
          "description": "Visibility scope tag."
        },
        "allowStudentRegistration": {
          "type": "boolean",
          "description": "Whether new student self-registration is allowed."
        },
        "communityEnabled": {
          "type": "boolean",
          "description": "Whether Student Community is enabled for students."
        },
        "communityPostingEnabled": {
          "type": "boolean",
          "description": "Whether students can create posts, comments, or messages."
        },
        "aiTutorEnabled": {
          "type": "boolean",
          "description": "Whether AI Studio is enabled for students."
        },
        "defaultLanguage": {
          "type": "string",
          "enum": ["en", "ku", "ar"],
          "description": "Default UI language code."
        },
        "maintenanceMessage": {
          "type": "string",
          "maxLength": 300,
          "description": "Optional notice banner displayed across the app."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of settings update."
        }
      },
      "required": [
        "settingId",
        "scope",
        "allowStudentRegistration",
        "communityEnabled",
        "communityPostingEnabled",
        "aiTutorEnabled",
        "defaultLanguage",
        "maintenanceMessage",
        "updatedAt"
      ]
    },
    "AccountRevocation": {
      "title": "AccountRevocation",
      "description": "PII-free admin-written tombstone signaling immediate cross-device session termination for deleted or disabled accounts.",
      "type": "object",
      "properties": {
        "revocationKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Deterministic revocation identifier (uid_<uid> or acct_<hash>)."
        },
        "targetUid": {
          "type": "string",
          "maxLength": 128,
          "description": "Deleted Firebase Auth UID if known."
        },
        "accountKey": {
          "type": "string",
          "maxLength": 128,
          "description": "SHA-256 derived account key for the revoked email."
        },
        "reason": {
          "type": "string",
          "enum": ["account_deleted", "account_disabled"],
          "description": "Reason for forced session termination."
        },
        "revokedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of revocation."
        }
      },
      "required": ["revocationKey", "reason", "revokedAt"]
    },
    "AnnouncementRecord": {
      "title": "AnnouncementRecord",
      "description": "School-wide announcements and study materials published by administrators or teachers.",
      "type": "object",
      "properties": {
        "announcementId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Announcement document ID."
        },
        "numericId": {
          "type": "number",
          "description": "Deterministic numeric ID for client UI lists."
        },
        "scope": {
          "type": "string",
          "enum": ["school"],
          "description": "Fixed scope for list queries."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Announcement title."
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "Announcement message body."
        },
        "type": {
          "type": "string",
          "enum": ["announcement", "material"],
          "description": "Announcement category."
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of publishing teacher or admin."
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Display name of publisher."
        },
        "attachmentName": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional attached filename."
        },
        "attachmentUrl": {
          "type": "string",
          "maxLength": 260000,
          "description": "Optional URL or compacted base64 attachment data URI."
        },
        "attachmentMime": {
          "type": "string",
          "maxLength": 120,
          "description": "Optional attachment MIME type."
        },
        "createdAtIso": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO timestamp string."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of publication."
        }
      },
      "required": ["announcementId", "numericId", "scope", "title", "content", "type", "authorUid", "authorName", "createdAt"]
    },
    "DirectMessageRecord": {
      "title": "DirectMessageRecord",
      "description": "Private 1-to-1 peer direct message between two authenticated Grade 9 Hub users.",
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Direct message document ID."
        },
        "numericId": {
          "type": "number",
          "description": "Numeric ID for UI ordering and deletion."
        },
        "senderUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Sender Firebase Auth UID."
        },
        "recipientUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Recipient Firebase Auth UID."
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Exactly two participant UIDs [senderUid, recipientUid]."
        },
        "senderNumericId": {
          "type": "number",
          "description": "Sender numeric ID."
        },
        "recipientNumericId": {
          "type": "number",
          "description": "Recipient numeric ID."
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Sender display name."
        },
        "senderAvatarUrl": {
          "type": "string",
          "maxLength": 200000,
          "description": "Sender avatar URI or empty string."
        },
        "senderRole": {
          "type": "string",
          "enum": ["student", "teacher"],
          "description": "Sender role."
        },
        "recipientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Recipient display name."
        },
        "messageText": {
          "type": "string",
          "maxLength": 4000,
          "description": "Message body text."
        },
        "attachmentName": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional attachment filename."
        },
        "attachmentUrl": {
          "type": "string",
          "maxLength": 260000,
          "description": "Optional attachment URL or compacted base64 data URI."
        },
        "attachmentMime": {
          "type": "string",
          "maxLength": 120,
          "description": "Optional attachment MIME type."
        },
        "createdAtIso": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO timestamp string."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of message delivery."
        }
      },
      "required": [
        "messageId",
        "numericId",
        "senderUid",
        "recipientUid",
        "participants",
        "senderNumericId",
        "recipientNumericId",
        "senderName",
        "senderRole",
        "recipientName",
        "messageText",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserAccount"
      },
      "description": "Owner-only and admin user profile documents."
    },
    "/users/{userId}/quiz_attempts/{attemptId}": {
      "schema": {
        "$ref": "#/entities/QuizAttemptRecord"
      },
      "description": "Immutable student quiz attempt records under user profile."
    },
    "/leaderboard_entries/{userId}": {
      "schema": {
        "$ref": "#/entities/LeaderboardEntry"
      },
      "description": "PII-free student competition leaderboard profiles."
    },
    "/admins/{userId}": {
      "schema": {
        "$ref": "#/entities/AdminRegistryEntry"
      },
      "description": "Verified administrator allowlist collection."
    },
    "/school_accounts/{accountKey}": {
      "schema": {
        "$ref": "#/entities/SchoolAccountSyncRecord"
      },
      "description": "Admin-only cloud mirror of school user accounts."
    },
    "/peer_presence/{userId}": {
      "schema": {
        "$ref": "#/entities/PeerPresence"
      },
      "description": "PII-free live online/offline presence and community peer roster."
    },
    "/app_settings/{settingId}": {
      "schema": {
        "$ref": "#/entities/AppSettingsDoc"
      },
      "description": "Global application settings managed by administrators."
    },
    "/account_revocations/{revocationKey}": {
      "schema": {
        "$ref": "#/entities/AccountRevocation"
      },
      "description": "Admin-managed account revocation records checked across active client sessions."
    },
    "/announcements/{announcementId}": {
      "schema": {
        "$ref": "#/entities/AnnouncementRecord"
      },
      "description": "School-wide announcements and study materials."
    },
    "/direct_messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/DirectMessageRecord"
      },
      "description": "Private 1-to-1 peer direct messages scoped to participants."
    }
  }
}

