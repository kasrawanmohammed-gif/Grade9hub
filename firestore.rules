rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Identity & Validation Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isEmailVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isSignedIn() {
      return request.auth != null && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'facebook.com'
      );
    }

    function isMainAdminEmail() {
      return isEmailVerified() && request.auth.token.email == 'mohamdm791@gmail.com';
    }

    function isAdmin() {
      return isEmailVerified() && (
        isMainAdminEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isTeacherUser() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserAccount(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'isAdmin', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'role',
          'isAdmin',
          'grade',
          'bio',
          'birthday',
          'avatarUrl',
          'notificationsEnabled',
          'notifPromptStatus',
          'totalPoints',
          'quizzesCompleted',
          'correctAnswers',
          'isRestricted',
          'restrictionReason',
          'lastLoginAt',
          'lastActiveAt',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string && data.uid == userId && isValidId(data.uid) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 180 &&
        data.role in ['student', 'teacher'] &&
        data.isAdmin is bool &&
        (!data.keys().hasAny(['grade']) || (data.grade is string && data.grade.size() <= 40)) &&
        (!data.keys().hasAny(['bio']) || (data.bio is string && data.bio.size() <= 500)) &&
        (!data.keys().hasAny(['birthday']) || (data.birthday is string && data.birthday.size() <= 20)) &&
        (!data.keys().hasAny(['avatarUrl']) || (data.avatarUrl is string && data.avatarUrl.size() <= 200000)) &&
        (!data.keys().hasAny(['notificationsEnabled']) || data.notificationsEnabled is bool) &&
        (!data.keys().hasAny(['notifPromptStatus']) || (data.notifPromptStatus is string && data.notifPromptStatus in ['', 'allowed', 'denied'])) &&
        (!data.keys().hasAny(['totalPoints']) || (data.totalPoints is number && data.totalPoints >= 0 && data.totalPoints <= 1000000)) &&
        (!data.keys().hasAny(['quizzesCompleted']) || (data.quizzesCompleted is number && data.quizzesCompleted >= 0 && data.quizzesCompleted <= 100000)) &&
        (!data.keys().hasAny(['correctAnswers']) || (data.correctAnswers is number && data.correctAnswers >= 0 && data.correctAnswers <= 1000000)) &&
        (!data.keys().hasAny(['isRestricted']) || data.isRestricted is bool) &&
        (!data.keys().hasAny(['restrictionReason']) || (data.restrictionReason is string && data.restrictionReason.size() <= 300)) &&
        (!data.keys().hasAny(['lastLoginAt']) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 64)) &&
        (!data.keys().hasAny(['lastActiveAt']) || (data.lastActiveAt is string && data.lastActiveAt.size() <= 64)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidQuizAttempt(data, userId) {
      return data.keys().hasAll([
          'userId',
          'mode',
          'chapterNumber',
          'totalQuestions',
          'correctCount',
          'scorePercent',
          'pointsAwarded',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'mode',
          'chapterNumber',
          'totalQuestions',
          'correctCount',
          'scorePercent',
          'pointsAwarded',
          'createdAt'
        ]) &&
        data.userId is string && data.userId == userId && isValidId(data.userId) &&
        data.mode in ['all_chapters', 'chapter', 'general'] &&
        data.chapterNumber is number && data.chapterNumber >= 0 && data.chapterNumber <= 11 &&
        data.totalQuestions is number && data.totalQuestions >= 0 && data.totalQuestions <= 500 &&
        data.correctCount is number && data.correctCount >= 0 && data.correctCount <= 500 &&
        data.scorePercent is number && data.scorePercent >= 0 && data.scorePercent <= 100 &&
        data.pointsAwarded is number && data.pointsAwarded >= 0 && data.pointsAwarded <= 1000 &&
        data.createdAt is timestamp;
    }

    function isValidLeaderboardEntry(data, userId) {
      return data.keys().hasAll([
          'uid',
          'name',
          'role',
          'totalPoints',
          'quizzesCompleted',
          'correctAnswers',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'name',
          'grade',
          'avatarUrl',
          'role',
          'totalPoints',
          'quizzesCompleted',
          'correctAnswers',
          'updatedAt'
        ]) &&
        data.uid is string && data.uid == userId && isValidId(data.uid) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        (!data.keys().hasAny(['grade']) || (data.grade is string && data.grade.size() <= 40)) &&
        (!data.keys().hasAny(['avatarUrl']) || (data.avatarUrl is string && data.avatarUrl.size() <= 200000)) &&
        data.role == 'student' &&
        data.totalPoints is number && data.totalPoints >= 0 && data.totalPoints <= 1000000 &&
        data.quizzesCompleted is number && data.quizzesCompleted >= 0 && data.quizzesCompleted <= 100000 &&
        data.correctAnswers is number && data.correctAnswers >= 0 && data.correctAnswers <= 1000000 &&
        data.updatedAt is timestamp;
    }

    function isValidAdminEntry(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
        data.uid is string && data.uid == userId && isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 180 &&
        data.createdAt is timestamp;
    }

    function isValidSchoolAccountSync(data, accountKey) {
      return data.keys().hasAll([
          'accountKey',
          'email',
          'name',
          'role',
          'isAdmin',
          'passwordHash',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'accountKey',
          'email',
          'name',
          'role',
          'isAdmin',
          'passwordHash',
          'grade',
          'bio',
          'birthday',
          'avatarUrl',
          'notifPromptStatus',
          'notificationsEnabled',
          'createdAtIso',
          'updatedAt'
        ]) &&
        data.accountKey is string && data.accountKey == accountKey && isValidId(data.accountKey) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 180 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.role in ['student', 'teacher'] &&
        data.isAdmin is bool &&
        data.passwordHash is string && data.passwordHash.size() >= 1 && data.passwordHash.size() <= 200 &&
        (!data.keys().hasAny(['grade']) || (data.grade is string && data.grade.size() <= 40)) &&
        (!data.keys().hasAny(['bio']) || (data.bio is string && data.bio.size() <= 500)) &&
        (!data.keys().hasAny(['birthday']) || (data.birthday is string && data.birthday.size() <= 20)) &&
        (!data.keys().hasAny(['avatarUrl']) || (data.avatarUrl is string && data.avatarUrl.size() <= 200000)) &&
        (!data.keys().hasAny(['notifPromptStatus']) || (data.notifPromptStatus is string && data.notifPromptStatus in ['', 'allowed', 'denied'])) &&
        (!data.keys().hasAny(['notificationsEnabled']) || data.notificationsEnabled is bool) &&
        (!data.keys().hasAny(['createdAtIso']) || (data.createdAtIso is string && data.createdAtIso.size() <= 64)) &&
        data.updatedAt is timestamp;
    }

    function isValidPeerPresence(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'role', 'isAdmin', 'online', 'updatedAt']) &&
        data.keys().hasOnly([
          'uid',
          'numericId',
          'name',
          'role',
          'isAdmin',
          'grade',
          'avatarUrl',
          'bio',
          'online',
          'currentSection',
          'isRestricted',
          'lastActiveAtIso',
          'updatedAt'
        ]) &&
        data.uid is string && data.uid == userId && isValidId(data.uid) &&
        (!data.keys().hasAny(['numericId']) || data.numericId is number) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        data.role in ['student', 'teacher'] &&
        data.isAdmin is bool &&
        (!data.keys().hasAny(['grade']) || (data.grade is string && data.grade.size() <= 40)) &&
        (!data.keys().hasAny(['avatarUrl']) || (data.avatarUrl is string && data.avatarUrl.size() <= 200000)) &&
        (!data.keys().hasAny(['bio']) || (data.bio is string && data.bio.size() <= 500)) &&
        data.online is bool &&
        (!data.keys().hasAny(['currentSection']) || (data.currentSection is string && data.currentSection.size() <= 40)) &&
        (!data.keys().hasAny(['isRestricted']) || data.isRestricted is bool) &&
        (!data.keys().hasAny(['lastActiveAtIso']) || (data.lastActiveAtIso is string && data.lastActiveAtIso.size() <= 64)) &&
        data.updatedAt is timestamp;
    }

    function isValidAppSettings(data, settingId) {
      return data.keys().hasAll([
          'settingId',
          'scope',
          'allowStudentRegistration',
          'communityEnabled',
          'communityPostingEnabled',
          'aiTutorEnabled',
          'defaultLanguage',
          'maintenanceMessage',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'settingId',
          'scope',
          'allowStudentRegistration',
          'communityEnabled',
          'communityPostingEnabled',
          'aiTutorEnabled',
          'defaultLanguage',
          'maintenanceMessage',
          'updatedAt'
        ]) &&
        data.settingId is string && data.settingId == settingId && isValidId(data.settingId) &&
        data.scope == 'public' &&
        data.allowStudentRegistration is bool &&
        data.communityEnabled is bool &&
        data.communityPostingEnabled is bool &&
        data.aiTutorEnabled is bool &&
        data.defaultLanguage in ['en', 'ku', 'ar'] &&
        data.maintenanceMessage is string && data.maintenanceMessage.size() <= 300 &&
        data.updatedAt is timestamp;
    }

    function isValidAccountRevocation(data, revocationKey) {
      return data.keys().hasAll(['revocationKey', 'reason', 'revokedAt']) &&
        data.keys().hasOnly([
          'revocationKey',
          'targetUid',
          'accountKey',
          'reason',
          'revokedAt'
        ]) &&
        data.revocationKey is string && data.revocationKey == revocationKey && isValidId(data.revocationKey) &&
        (!data.keys().hasAny(['targetUid']) || (data.targetUid is string && data.targetUid.size() <= 128)) &&
        (!data.keys().hasAny(['accountKey']) || (data.accountKey is string && data.accountKey.size() <= 128)) &&
        data.reason in ['account_deleted', 'account_disabled'] &&
        data.revokedAt is timestamp;
    }

    function isValidAnnouncementDoc(data, announcementId) {
      return data.keys().hasAll([
          'announcementId',
          'numericId',
          'scope',
          'title',
          'content',
          'type',
          'authorUid',
          'authorName',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'announcementId',
          'numericId',
          'scope',
          'title',
          'content',
          'type',
          'authorUid',
          'authorName',
          'attachmentName',
          'attachmentUrl',
          'attachmentMime',
          'createdAtIso',
          'createdAt'
        ]) &&
        data.announcementId is string && data.announcementId == announcementId && isValidId(data.announcementId) &&
        data.numericId is number && data.numericId >= 1 &&
        data.scope == 'school' &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 8000 &&
        data.type in ['announcement', 'material'] &&
        data.authorUid is string && isValidId(data.authorUid) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 120 &&
        (!data.keys().hasAny(['attachmentName']) || (data.attachmentName is string && data.attachmentName.size() <= 200)) &&
        (!data.keys().hasAny(['attachmentUrl']) || (data.attachmentUrl is string && data.attachmentUrl.size() <= 260000)) &&
        (!data.keys().hasAny(['attachmentMime']) || (data.attachmentMime is string && data.attachmentMime.size() <= 120)) &&
        (!data.keys().hasAny(['createdAtIso']) || (data.createdAtIso is string && data.createdAtIso.size() <= 64)) &&
        data.createdAt is timestamp;
    }

    function isValidDirectMessage(data, messageId) {
      return data.keys().hasAll([
          'messageId',
          'numericId',
          'senderUid',
          'recipientUid',
          'participants',
          'senderNumericId',
          'recipientNumericId',
          'senderName',
          'senderRole',
          'recipientName',
          'messageText',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'messageId',
          'numericId',
          'senderUid',
          'recipientUid',
          'participants',
          'senderNumericId',
          'recipientNumericId',
          'senderName',
          'senderAvatarUrl',
          'senderRole',
          'recipientName',
          'messageText',
          'attachmentName',
          'attachmentUrl',
          'attachmentMime',
          'createdAtIso',
          'createdAt'
        ]) &&
        data.messageId is string && data.messageId == messageId && isValidId(data.messageId) &&
        data.numericId is number && data.numericId >= 1 &&
        data.senderUid is string && isValidId(data.senderUid) &&
        data.recipientUid is string && isValidId(data.recipientUid) &&
        data.participants is list &&
        data.participants.size() == 2 &&
        data.participants[0] is string &&
        data.participants[1] is string &&
        data.senderUid in data.participants &&
        data.recipientUid in data.participants &&
        data.senderNumericId is number && data.senderNumericId >= 1 &&
        data.recipientNumericId is number && data.recipientNumericId >= 1 &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 120 &&
        (!data.keys().hasAny(['senderAvatarUrl']) || (data.senderAvatarUrl is string && data.senderAvatarUrl.size() <= 200000)) &&
        data.senderRole in ['student', 'teacher'] &&
        data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 120 &&
        data.messageText is string && data.messageText.size() <= 4000 &&
        (!data.keys().hasAny(['attachmentName']) || (data.attachmentName is string && data.attachmentName.size() <= 200)) &&
        (!data.keys().hasAny(['attachmentUrl']) || (data.attachmentUrl is string && data.attachmentUrl.size() <= 260000)) &&
        (!data.keys().hasAny(['attachmentMime']) || (data.attachmentMime is string && data.attachmentMime.size() <= 120)) &&
        (!data.keys().hasAny(['createdAtIso']) || (data.createdAtIso is string && data.createdAtIso.size() <= 64)) &&
        (
          data.messageText.size() > 0 ||
          (data.keys().hasAny(['attachmentUrl']) && data.attachmentUrl is string && data.attachmentUrl.size() > 0)
        ) &&
        data.createdAt is timestamp;
    }

    // 1. Private User Accounts (/users/{userId}) - PII isolated to Owner or Admin
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() && resource.data.role in ['student', 'teacher'];

      allow create: if isValidId(userId) &&
        isValidUserAccount(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (
            isOwner(userId) &&
            request.auth.token.email is string &&
            incoming().email == request.auth.token.email &&
            (
              isMainAdminEmail()
                ? (incoming().role == 'teacher' && incoming().isAdmin == true)
                : (incoming().role == 'student' && incoming().isAdmin == false)
            )
          ) ||
          isAdmin()
        );

      allow update: if isValidId(userId) &&
        isValidUserAccount(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isAdmin() &&
            (
              existing().email != 'mohamdm791@gmail.com' ||
              (
                incoming().role == 'teacher' &&
                incoming().isAdmin == true &&
                (!incoming().keys().hasAny(['isRestricted']) || incoming().isRestricted == false)
              )
            )
          ) ||
          (
            isOwner(userId) &&
            incoming().role == existing().role &&
            incoming().isAdmin == existing().isAdmin &&
            (!incoming().keys().hasAny(['isRestricted']) || (existing().keys().hasAny(['isRestricted']) && incoming().isRestricted == existing().isRestricted) || incoming().isRestricted == false) &&
            (!incoming().keys().hasAny(['restrictionReason']) || (existing().keys().hasAny(['restrictionReason']) && incoming().restrictionReason == existing().restrictionReason) || incoming().restrictionReason == '') &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name',
              'grade',
              'bio',
              'birthday',
              'avatarUrl',
              'notificationsEnabled',
              'notifPromptStatus',
              'totalPoints',
              'quizzesCompleted',
              'correctAnswers',
              'lastLoginAt',
              'lastActiveAt',
              'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(userId) &&
        existing().email != 'mohamdm791@gmail.com' &&
        (isOwner(userId) || isAdmin());

      // Master Gate Subcollection: Quiz Attempts (/users/{userId}/quiz_attempts/{attemptId})
      match /quiz_attempts/{attemptId} {
        allow get: if isValidId(userId) && isValidId(attemptId) && (isOwner(userId) || isAdmin()) &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == userId;
        allow list: if isSignedIn() && resource.data.userId is string &&
          (resource.data.userId == request.auth.uid || isAdmin());

        allow create: if isValidId(userId) && isValidId(attemptId) &&
          (isOwner(userId) || isAdmin()) &&
          isValidQuizAttempt(incoming(), userId) &&
          incoming().createdAt == request.time &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == userId;

        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(attemptId) && (isOwner(userId) || isAdmin());
      }
    }

    // 2. PII-Free Public Student Leaderboard (/leaderboard_entries/{userId})
    match /leaderboard_entries/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isSignedIn() && resource.data.role == 'student';

      allow create: if isValidId(userId) &&
        (isOwner(userId) || isAdmin()) &&
        isValidLeaderboardEntry(incoming(), userId) &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(userId) &&
        (isOwner(userId) || isAdmin()) &&
        isValidLeaderboardEntry(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().role == existing().role &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'grade',
          'avatarUrl',
          'totalPoints',
          'quizzesCompleted',
          'correctAnswers',
          'updatedAt'
        ]);

      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // 3. Verified Admins Registry (/admins/{userId})
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() && resource.data.email is string;
      allow create, update: if isValidId(userId) &&
        isMainAdminEmail() &&
        isValidAdminEntry(incoming(), userId) &&
        incoming().createdAt == request.time;
      allow delete: if isValidId(userId) &&
        isMainAdminEmail() &&
        existing().email != 'mohamdm791@gmail.com';
    }

    // 4. Admin-Only School Account Mirror (/school_accounts/{accountKey})
    match /school_accounts/{accountKey} {
      allow get: if isValidId(accountKey) && isAdmin();
      allow list: if isAdmin() && resource.data.role in ['student', 'teacher'];
      allow create: if isValidId(accountKey) &&
        isAdmin() &&
        isValidSchoolAccountSync(incoming(), accountKey) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(accountKey) &&
        isAdmin() &&
        isValidSchoolAccountSync(incoming(), accountKey) &&
        incoming().accountKey == existing().accountKey &&
        incoming().email == existing().email &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'role',
          'isAdmin',
          'passwordHash',
          'grade',
          'bio',
          'birthday',
          'avatarUrl',
          'notifPromptStatus',
          'notificationsEnabled',
          'createdAtIso',
          'updatedAt'
        ]);
      allow delete: if isValidId(accountKey) &&
        isAdmin() &&
        existing().email != 'mohamdm791@gmail.com';
    }

    // 5. PII-Free Live Online/Offline Presence & Community Peers (/peer_presence/{userId})
    match /peer_presence/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isSignedIn() && resource.data.role in ['student', 'teacher'];

      allow create: if isValidId(userId) &&
        isValidPeerPresence(incoming(), userId) &&
        incoming().updatedAt == request.time &&
        (
          (
            isOwner(userId) &&
            (
              isMainAdminEmail()
                ? true
                : (incoming().role == 'student' && incoming().isAdmin == false && (!incoming().keys().hasAny(['isRestricted']) || incoming().isRestricted == false))
            )
          ) ||
          isAdmin()
        );

      allow update: if isValidId(userId) &&
        isValidPeerPresence(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            isOwner(userId) &&
            incoming().role == existing().role &&
            incoming().isAdmin == existing().isAdmin &&
            (!incoming().keys().hasAny(['isRestricted']) || (existing().keys().hasAny(['isRestricted']) && incoming().isRestricted == existing().isRestricted) || incoming().isRestricted == false) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'numericId',
              'name',
              'grade',
              'avatarUrl',
              'bio',
              'online',
              'currentSection',
              'lastActiveAtIso',
              'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // 6. Global App Settings (/app_settings/{settingId})
    match /app_settings/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'global';
      allow list: if isSignedIn() && resource.data.scope == 'public';
      allow create, update: if isValidId(settingId) &&
        settingId == 'global' &&
        isAdmin() &&
        isValidAppSettings(incoming(), settingId) &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // 7. Account Revocations (/account_revocations/{revocationKey}) - Cross-device immediate sign-out
    match /account_revocations/{revocationKey} {
      allow get: if isValidId(revocationKey) && isSignedIn();
      allow list: if isAdmin() && resource.data.reason in ['account_deleted', 'account_disabled'];
      allow create, update: if isValidId(revocationKey) &&
        isAdmin() &&
        isValidAccountRevocation(incoming(), revocationKey) &&
        incoming().revokedAt == request.time;
      allow delete: if isValidId(revocationKey) && isAdmin();
    }

    // 8. School Announcements & Materials (/announcements/{announcementId})
    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId) && isSignedIn();
      allow list: if isSignedIn() && resource.data.scope == 'school';
      allow create: if isValidId(announcementId) &&
        (isAdmin() || isTeacherUser()) &&
        isValidAnnouncementDoc(incoming(), announcementId) &&
        incoming().authorUid == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(announcementId) &&
        (isAdmin() || (isTeacherUser() && existing().authorUid == request.auth.uid));
    }

    // 9. Private Peer Direct Messages (/direct_messages/{messageId})
    match /direct_messages/{messageId} {
      allow get: if isValidId(messageId) &&
        isSignedIn() &&
        (request.auth.uid in existing().participants || isAdmin());
      allow list: if isSignedIn() &&
        resource.data.participants is list &&
        request.auth.uid in resource.data.participants;
      allow create: if isValidId(messageId) &&
        isSignedIn() &&
        isValidDirectMessage(incoming(), messageId) &&
        incoming().senderUid == request.auth.uid &&
        incoming().senderUid != incoming().recipientUid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(messageId) &&
        isSignedIn() &&
        (existing().senderUid == request.auth.uid || isAdmin());
    }
  }
}
