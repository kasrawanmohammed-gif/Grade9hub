# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# SESSION_SECRET / JWT_SECRET: Static persistent keys for signing sessions and encrypted recovery passports.
# Keep these constant across rebuilds so user sessions remain valid after updates.
SESSION_SECRET="majquiz-change-this-secret-in-production"
JWT_SECRET="grade9hub-persistent-jwt-secret-v1"

# SMTP Configuration for Forgot Password Gmail verification codes
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MajQuiz Educational Hub <noreply@majquiz.edu>"

# Web Push (VAPID) Keys for background & lock-screen system notifications
# Generate with: npm run vapid:generate
# Required on Vercel (Settings -> Environment Variables); auto-generated locally if omitted.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:mohamdm791@gmail.com"
# Optional build-time public key fallback for static hosts
VITE_VAPID_PUBLIC_KEY=""

# Persistent Push Subscription Store on Vercel Serverless Functions (Upstash Redis / Vercel KV REST API)
# Recommended on Vercel so push subscriptions persist across cold starts & regions:
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Or Vercel KV equivalents:
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""

# Optional Direct Facebook OAuth fallback (only needed if Facebook is not enabled in Firebase Authentication)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Optional external backend API base URL (if deploying frontend separately from server.ts)
VITE_API_BASE_URL=""

